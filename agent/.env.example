# Sui
SUI_PRIVATE_KEY=
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Midnight
MIDNIGHT_NETWORK=preprod
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# DeepSeek (via OpenRouter — LangChain OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Agent Config
AGENT_INTERVAL_MS=300000
FEE_RATE_BPS=100
MAX_IL_THRESHOLD_BPS=500
TARGET_APY_BPS=1500

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=zkurrent

# ── API Server ──
API_PORT=4020

# ── x402 Payment ──
X402_RECIPIENT_ADDRESS=0x...

# ── Pyth Network (Sui on-chain price feeds) ──
PYTH_PACKAGE_ID=
PYTH_SUI_FEED_ID=
PYTH_ETH_FEED_ID=
PYTH_USDC_FEED_ID=
DEEPBOOK_PACKAGE_ID=
CETUS_PACKAGE_ID=
CETUS_DLMM_PACKAGE_ID=
TURBOS_PACKAGE_ID=

# ── Sui Indexer ──
SUI_INDEXER_URL=https://sui-mainnet.indexer.xyz/graphql

# ── Logging ──
LOG_LEVEL=info

